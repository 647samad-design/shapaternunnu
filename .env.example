# Copy this file to .env and fill in your own values.
# Never commit .env to git.

# --- Core -------------------------------------------------------------------
# True for local development only. Production must run with DEBUG=False.
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
# Production domains, comma-separated (required when DEBUG=False)
# ALLOWED_HOSTS=shop.example.com,www.shop.example.com
# CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
# Reverse proxies in front of Django (Render/Railway/Heroku/Fly = 1). Used for rate limiting.
# NUM_PROXIES=1

# --- Supabase database (Postgres) -------------------------------------------
# Supabase > Project Settings > Database > Connection string (URI).
# Session pooler (port 5432) for a normal server; transaction pooler (6543) for serverless.
# Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Encrypted database connection: decided automatically (on for remote hosts,
# off for localhost / Docker). Force it with DATABASE_SSL=True or False.
# DATABASE_SSL=

# --- Supabase Storage (product images + private seller documents) -----------
# Supabase > Storage: create a PUBLIC bucket (e.g. "media") and a PRIVATE bucket (e.g. "private").
# Supabase > Storage > Settings > S3 Connection: enable, then create an access key.
# Leave unset to store uploads on the local disk.
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_S3_REGION=us-east-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_PRIVATE_BUCKET=private

# --- Stripe (card, Apple Pay, Google Pay) -----------------------------------
# Dashboard > Developers > API keys. Use sk_test_/pk_test_ keys until you go live.
# Card payments stay hidden at checkout until STRIPE_SECRET_KEY is set.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard > Developers > Webhooks > Add endpoint: https://YOUR-DOMAIN/payment/stripe/webhook/
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
# STRIPE_WEBHOOK_SECRET=whsec_...
# Only on PythonAnywhere FREE (it blocks api.stripe.com): route Stripe calls
# through the Supabase Edge Function in deploy/supabase/stripe-relay.
# STRIPE_API_BASE=https://abcdefghijklmnop.supabase.co/functions/v1/stripe-relay/YOUR-RELAY-SECRET
# Three-letter currency code used for prices and Stripe charges.
STORE_CURRENCY=usd

# --- Email ------------------------------------------------------------------
# Any SMTP provider works (SendGrid, Mailgun, Postmark, Amazon SES, Resend, Gmail app password).
# Without these, emails are printed to the console.
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Lumen Market <orders@example.com>

# --- Couriers (labels + live tracking) --------------------------------------
# Pick the service in Store settings > Shipping labels, then add its key here
# (or paste it in Store settings > Keys & passwords).
# EASYPOST_API_KEY=
# SHIPPO_API_TOKEN=shippo_test_...
# Secret part of the courier webhook address (Keys & passwords can create it)
# SHIPPING_WEBHOOK_TOKEN=

# --- REST API (/api/v1/, docs at /api/v1/docs/) ------------------------------
# Days a sign-in token from POST /api/v1/auth/token/ stays valid (default 90)
# API_TOKEN_DAYS=90
# Requests per minute without / with a token
# API_RATE_ANON=120/min
# API_RATE_USER=600/min

# --- Optional ---------------------------------------------------------------
# Shared cache for rate limiting when running several app processes
# REDIS_URL=redis://localhost:6379/0
# Error monitoring (https://sentry.io > Create project > Django)
# SENTRY_DSN=
